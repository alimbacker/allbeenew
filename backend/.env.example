# ---------------------------------------------------------------------------
# ALLBEE Instant - backend configuration
# Copy to `.env` and edit. Never commit `.env`.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true

# --- Database ---------------------------------------------------------------
# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql://allbee:allbee@localhost:5432/allbee

# --- Auth -------------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-secret
JWT_EXPIRE_MINUTES=10080

# --- Storage ----------------------------------------------------------------
# Relative paths resolve against the backend/ directory.
# In production use an absolute path, e.g. /var/lib/allbee/storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=25
THUMBNAIL_MAX_EDGE=640
THUMBNAIL_QUALITY=82

# --- Face recognition -------------------------------------------------------
# arcface = SCRFD + ArcFace via onnxruntime (default, most accurate, ~190 MB)
# opencv  = YuNet + SFace via OpenCV        (lighter, ~39 MB, less accurate)
FACE_ENGINE=arcface
FACE_MODEL_PACK=buffalo_l
FACE_MODEL_DIR=./models
FACE_DETECT_SIZE=640
FACE_DETECT_THRESHOLD=0.5

# Ignore faces smaller than this many pixels. Raise it to stop distant
# background faces from being indexed at large venues.
FACE_MIN_SIZE=32

# Cosine similarity required to call it a match, from -1.0 to 1.0.
# Calibrated for the arcface engine. Lower = more photos, more false matches.
#   0.30  very inclusive
#   0.38  default: good recall in mixed event lighting
#   0.50  conservative
#   0.55  high precision; will miss profile shots and motion blur
# Use ~0.30 instead when FACE_ENGINE=opencv. See docs/FACE_RECOGNITION.md.
FACE_MATCH_THRESHOLD=0.38
FACE_MAX_RESULTS=300

# --- Background processing --------------------------------------------------
# Face detection is CPU-bound. Roughly one worker per two cores.
WORKER_CONCURRENCY=2

# --- URLs -------------------------------------------------------------------
# Where the guest frontend lives. QR codes encode PUBLIC_BASE_URL/event/{code},
# so this must be reachable from a guest's phone -- not "localhost" in production.
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting ----------------------------------------------------------
SEARCH_RATE_LIMIT=10
SEARCH_RATE_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=600
UPLOAD_RATE_WINDOW_SECONDS=60

# --- Privacy ----------------------------------------------------------------
# Days to keep guest selfies and search history. 0 = keep indefinitely.
# Nothing is ever deleted automatically unless this is greater than 0.
GUEST_DATA_RETENTION_DAYS=0
