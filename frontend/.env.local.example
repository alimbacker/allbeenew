# Where the browser should send API requests.
#
# Leave this UNSET for local development: next.config.mjs proxies /api to
# FastAPI on the same origin, so there is no CORS to configure.
#
# Set it when the frontend and backend are on different hosts -- for example
# the frontend on Vercel and the backend on a VPS. It must be the public
# HTTPS URL of your backend, reachable from a guest's phone.
#
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
