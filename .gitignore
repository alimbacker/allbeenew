# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
!.env.local.example

# --- Uploaded photos and face models -----------------------------------------
# Never commit event photos: they are other people's personal data.
# Track the folder so a fresh clone has somewhere to write, never its contents.
# NOTE: a bare `storage/` would match at any depth, and git will not descend
# into an excluded directory -- which silently defeats the negation below.
# Both patterns are anchored for that reason.
/backend/storage/*
!/backend/storage/.gitkeep
/storage/
# Model files are large and are fetched by `python -m app.face.download`.
backend/models/
*.onnx

